# Snck — AI Platform specific deployment settings
# Copy these values into the existing .env only when needed.

# Internal Ollama service used by the Snck Local endpoint.
OLLAMA_BASE_URL=http://ollama:11434

# Optional external Ollama URL. Keep Ollama private and authenticated when exposed remotely.
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Do not place provider API keys in this file unless you intentionally configure a shared provider.
# For per-user third-party keys, use the Snck Custom API endpoint in the UI.
